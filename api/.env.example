DATABASE_URL="file:./dev.db"
PORT=4000
JWT_SECRET="secret-key-development-only"
# Token de MercadoPago: TEST-... para probar en sandbox, APP_USR-... para producción real.
MERCADO_PAGO_ACCESS_TOKEN="test-token"
MERCADO_PAGO_PUBLIC_KEY="test-public-key"
# URL pública de la web (usada por MercadoPago para los back_urls del checkout).
WEB_APP_URL="http://localhost:3000"
# URL pública del API (usada para el notification_url de MercadoPago).
# En producción debe ser HTTPS accesible desde internet (p. ej. https://tu-api.onrender.com).
API_BASE_URL="http://localhost:4000"
# [OPCIONAL] URL exacta del webhook si difiere del default `${API_BASE_URL}/api/pagos/webhook`.
MERCADO_PAGO_NOTIFICATION_URL=

# [OPCIONAL] Token de Apify para el servicio de scraping externo (Estrategia D).
# La única vía para recolectar TODOS los comentarios de Instagram SIN iniciar sesión.
# Crear cuenta gratuita en apify.com → Settings → Integrations → API token.
# Free tier: 5 USD de créditos/mes que se renuevan (no se acumulan).
APIFY_TOKEN=

# [OPCIONAL] Token de ScrapFly como alternativa (Estrategia F).
# Free tier: 1000 requests/mes. Crear cuenta gratuita en scrapfly.io → API Key.
# Usa session pooling (sesiones compartidas, a veces logueadas) con render+asp.
SCRAPFLY_TOKEN=

# [OPCIONAL] Cuota mensual de sorteos gratuitos respaldados por Apify (créditos gratis de apify.com).
# Free tier de Apify: 5 USD/mes ≈ 45 sorteos. La cuota se recalcula a diario (restantes/días del mes)
# y al agotarse se ofrece el Pase Rápido (pago) o la cola de espera. 0 = sin límite (uso local).
APIFY_CUOTA_MENSUAL=45

# [OPCIONAL] Precio del Pase Rápido en pesos argentinos (salta la cola cuando se agota la cuota).
PRECIO_PASE_COLA=2500
